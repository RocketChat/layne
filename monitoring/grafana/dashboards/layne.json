{
  "title": "Layne Security Scanner",
  "uid": "layne-security-scanner",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Scan Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (conclusion) (rate(layne_scans_total[5m]))",
          "legendFormat": "{{conclusion}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "Scan Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(layne_scan_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(layne_scan_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 3,
      "title": "Findings by Severity (rate)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (severity) (rate(layne_findings_total[5m]))",
          "legendFormat": "{{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }] },
          { "matcher": { "id": "byName", "options": "high" },     "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "medium" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "low" },      "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      }
    },
    {
      "id": 4,
      "title": "Queue Depth",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "layne_queue_waiting", "legendFormat": "waiting" },
        { "expr": "layne_queue_active",  "legendFormat": "active" },
        { "expr": "layne_queue_failed",  "legendFormat": "failed" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "id": 5,
      "title": "Timeouts & Retries",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(layne_scan_timeouts_total[5m])", "legendFormat": "timeouts" },
        { "expr": "rate(layne_scan_retries_total[5m])",  "legendFormat": "retries" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 6,
      "title": "Webhook Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (action, deduplicated) (rate(layne_webhooks_total[5m]))",
          "legendFormat": "{{action}} dedup={{deduplicated}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 7,
      "title": "Top Repos by Findings",
      "type": "table",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "topk(10, sum by (owner, repo) (increase(layne_findings_total[24h])))",
          "legendFormat": "{{owner}}/{{repo}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 8,
      "title": "Findings Distribution per Scan",
      "type": "histogram",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (le) (layne_findings_per_scan_bucket)",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Spectre Complete / Incomplete Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(layne_spectre_scans_total{outcome=~\"complete|incomplete\"}[5m]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10 } }
      }
    },
    {
      "id": 10,
      "title": "Spectre Incomplete Reasons",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (provider, reason) (rate(layne_spectre_scans_total{outcome=\"incomplete\"}[5m]))",
          "legendFormat": "{{provider}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10 } }
      }
    },
    {
      "id": 11,
      "title": "Spectre Provider Request Latency (p95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (provider, outcome, le) (rate(layne_spectre_provider_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 }
      }
    },
    {
      "id": 12,
      "title": "Spectre Chunk Completion",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(layne_spectre_chunks_total[5m]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10 } }
      }
    },
    {
      "id": 13,
      "title": "Spectre Governor Denials",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 48, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (provider, backend, reason) (rate(layne_spectre_governor_decisions_total{outcome=\"denied\"}[5m]))",
          "legendFormat": "{{provider}} {{backend}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 }
      }
    },
    {
      "id": 14,
      "title": "Spectre Circuit State",
      "description": "0 = closed, 1 = open, 2 = half-open",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 48, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "max by (provider, backend) (layne_spectre_circuit_state)",
          "legendFormat": "{{provider}} {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 2 }
      }
    },
    {
      "id": 15,
      "title": "Spectre Governor Backend Errors",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 56, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (provider, backend, operation) (rate(layne_spectre_governor_backend_errors_total[5m]))",
          "legendFormat": "{{provider}} {{backend}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 }
      }
    },
    {
      "id": 16,
      "title": "Spectre Governor Lease Recoveries",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 56, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (provider, backend) (rate(layne_spectre_governor_lease_recoveries_total[5m]))",
          "legendFormat": "{{provider}} {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 }
      }
    }
  ]
}
