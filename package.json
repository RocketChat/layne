{
  "name": "layne",
  "version": "2.0.0",
  "description": "Centralized appsec scanning GitHub App",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.scripts.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:redis": "docker compose -f docker-compose.dev.yml up -d",
    "dev:stop": "docker compose -f docker-compose.dev.yml down",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "replay": "node dist-scripts/scripts/replay-webhook.js",
    "validate-config": "node dist-scripts/scripts/validate-config.js",
    "spectre:eval": "tsx scripts/evaluate-spectre.ts",
    "spectre:simulate": "tsx scripts/simulate-spectre.ts",
    "spectre:eval:codex": "tsx scripts/evaluate-spectre-codex.ts",
    "spectre:eval:compare": "tsx scripts/compare-spectre-evals.ts",
    "spectre:replay:prs": "tsx scripts/replay-spectre-pr-routing.ts",
    "spectre:battle:ast": "vitest run src/__tests__/spectre-ast-routing-corpus.test.ts src/__tests__/spectre-ast-semantic-corpus.test.ts src/__tests__/spectre-structural-adversarial.test.ts src/__tests__/spectre-structural-stress.test.ts src/__tests__/spectre-routing-evaluation.test.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset tag",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "npm --prefix website run start",
    "docs:build": "npm --prefix website run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@earendil-works/pi-ai": "0.84.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "bullmq": "^5.76.2",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "ioredis": "^5.0.0",
    "prom-client": "^15.1.3",
    "tinyglobby": "^0.2.15",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0",
    "web-tree-sitter": "0.25.10",
    "tree-sitter-wasms": "0.1.13"
  },
  "overrides": {
    "@earendil-works/pi-telemetry": "0.84.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/express": "~4.17.0",
    "@types/node": "~22.0.0",
    "@types/supertest": "~6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "supertest": "^7.0.0",
    "tsx": "~4.19.0",
    "typescript": "~5.8.0",
    "vitest": "^4.0.18"
  }
}
