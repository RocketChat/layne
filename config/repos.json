{
  "acme/frontend": {
    "semgrep": {
      "extraArgs": ["--config", "p/owasp-top-ten", "--severity", "WARNING"]
    },
    "trufflehog": {
      "extraArgs": ["--only-verified"]
    },
    "claude": {
      "enabled": true
    }
  },
  "acme/backend": {
    "semgrep": {
      "extraArgs": ["--config", "p/security-audit", "--config", "p/python"]
    }
  },
  "acme/internal-tool": {
    "trufflehog": {
      "enabled": false
    }
  },
  "acme/payments": {
    "claude": {
      "enabled": true,
      "model": "claude-opus-4-6"
    }
  },
  "RocketChat/security": {
    "claude": {
      "enabled": true
    }
  }
}
