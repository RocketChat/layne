{
  "$global": {
    "notifications": {
      "rocketchat": {
        "enabled": true,
        "webhookUrl": "$ROCKETCHAT_WEBHOOK_URL"
      }
    },
    "labels": {
      "onFailure": ["needs-security-review"],
      "removeOnSuccess": ["needs-security-review"],
      "onSuccess": [],
      "removeOnFailure": [],
      "onException": ["security-exception-used"]
    }
  },
  "acme/frontend": {
    "semgrep": {
      "extraArgs": ["--config", "p/owasp-top-ten", "--severity", "WARNING"]
    },
    "trufflehog": {
      "extraArgs": ["--only-verified"]
    },
    "claude": {
      "enabled": true
    }
  },
  "acme/backend": {
    "semgrep": {
      "extraArgs": ["--config", "p/security-audit", "--config", "p/python"]
    }
  },
  "acme/internal-tool": {
    "trufflehog": {
      "enabled": false
    }
  },
  "acme/payments": {
    "claude": {
      "enabled": true,
      "model": "claude-sonnet-4-6",
      "prompt": "You are a security reviewer specialising in payment systems. Analyse the provided source files for malicious intent: reverse shells, backdoors, credential exfiltration, obfuscated payloads, and supply-chain attacks. Pay extra attention to anything that could exfiltrate card data or PII. Report ONLY confirmed malicious patterns with high confidence. Call `report_findings` with your results."
    },
    "notifications": {
      "rocketchat": {
        "enabled": true,
        "webhookUrl": "$PAYMENTS_ROCKETCHAT_WEBHOOK_URL",
        "template": ":rotating_light: *Payment system alert — {{repo}} PR #{{prNumber}}*\n{{total}} finding(s): {{critical}} critical, {{high}} high, {{medium}} medium, {{low}} low"
      }
    },
    "exceptionApprovers": {
      "users": ["payments-security-lead"],
      "teams": ["acme/payments-security"]
    }
  },
  "RocketChat/security": {
    "claude": {
      "enabled": false
    },
    "piAgent": {
      "enabled": true,
      "model": "claude-haiku-4-5-20251001"
    }
  },
  "RocketChat/Rocket.Chat.ReactNative": {
    "semgrep": {
      "extraArgs": ["--severity", "ERROR"]
    },
    "claude": {
      "enabled": false
    }
  }
}
